{
  "id": "vasukiPrototype01",
  "name": "VASUKI \u00b7 Autonomous security patch pipeline",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 1800
  },
  "nodes": [
    {
      "id": "repository-intake",
      "name": "Repository intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "vasuki-security-trigger",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "1c975faa-49e1-4614-a2bd-7926059419f3"
    },
    {
      "id": "submit-to-vasuki",
      "name": "Submit to VASUKI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/analysis/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "return-scan-id",
      "name": "Return scan ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        480,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "wait-for-agents",
      "name": "Wait for agents",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      }
    },
    {
      "id": "read-real-results",
      "name": "Read real results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "={{ 'http://api:8000/api/analysis/' + $('Submit to VASUKI').first().json.scan_id }}",
        "options": {}
      }
    },
    {
      "id": "terminal-outcome",
      "name": "Terminal outcome",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "terminal-check",
              "leftValue": "={{ ['completed', 'blocked', 'failed'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "retain-outcome-and-pr-evidence",
      "name": "Retain outcome and PR evidence",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1460,
        -80
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Repository intake": {
      "main": [
        [
          {
            "node": "Submit to VASUKI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit to VASUKI": {
      "main": [
        [
          {
            "node": "Return scan ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Return scan ID": {
      "main": [
        [
          {
            "node": "Wait for agents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for agents": {
      "main": [
        [
          {
            "node": "Read real results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read real results": {
      "main": [
        [
          {
            "node": "Terminal outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Terminal outcome": {
      "main": [
        [
          {
            "node": "Retain outcome and PR evidence",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for agents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}