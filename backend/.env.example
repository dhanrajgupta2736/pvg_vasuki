GITHUB_TOKEN=
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_AUTH_MODE=config
OCI_COMPARTMENT_ID=
OCI_GENAI_ENDPOINT=https://inference.generativeai.ap-mumbai-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=google.gemini-2.5-flash
USE_LLM=true
SCANNER_MODE=native
# DATABASE_URL defaults to an absolute backend/vasuki.db path.
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
MAX_REPO_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=60
MAX_PATCHES=10
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
