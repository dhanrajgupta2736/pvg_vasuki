# ── GITHUB ─────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github_app.pem

# ── ORACLE OCI GEN AI ──────────────────────────────────
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=your_compartment_ocid
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=meta.llama-3-3-70b-instruct   # Llama 3.3 70B via Oracle

# ── AWS (BACKUP) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── DATABASE ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vasuki:vasuki_pass@localhost:5432/vasuki_db

# ── REDIS ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── APP ─────────────────────────────────────────────────
APP_SECRET=changeme_super_secret_key
FRONTEND_URL=http://localhost:5173
MAX_REPO_SIZE_MB=500
SCAN_TIMEOUT_SECONDS=300
DOCKER_SANDBOX_IMAGE=python:3.11-slim
